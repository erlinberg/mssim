{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Quantum Circuit Execution Config",
    "type": "object",
    "additionalProperties": true,
    "properties": {
        "model": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "circuit": { "type": "string" },
                "n_qubits": { "type": "integer", "minimum": 1 },
                "depth": { "type": "integer", "minimum": 1 },
                "observable": { "type": ["string", "null"] },
                "kwargs": { "type": "object", "additionalProperties": true }
            }
        },
        "execution": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
                "engine": { "type": "string" },
                "n_runs": { "type": "integer", "minimum": 1 },
                "max_bond_dimension": { "type": ["integer", "null"], "minimum": 1 },
                "max_terms": { "type": ["integer", "null"], "minimum": 1 }
            }
        },
        "sweep": {
            "type": "object",
            "additionalProperties": true,
            "description": "Any configuration parameter swept as an array.",
            "patternProperties": {
                "^.*$": {
                    "type": "array",
                    "minItems": 1
                }
            }
        },
        "output": {
            "type": "object",
            "required": ["filename"],
            "properties": {
                "filename": { "type": "string" },
                "format": { "type": "string", "enum": ["jsonl", "hdf5", "h5"] },
                "verbose": { "type": "boolean" }
            }
        }
    }
}
