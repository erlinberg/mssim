{
  "model": {
    "circuit": "cme",
    "kwargs": {
      "K": 3,
      "M": 0.5
    }
  },

  "execution": {
    "engines": ["qiskit", "quimb", "mpstab"],
    "n_runs": 5,
    "max_bond_dimension": 16
  },

  "sweep": {
    "n_qubits": [10,20,30],
    "depth":    [1,2,3]
  },

  "output": {
    "filename": "results/result.jsonl",
    "format":   "jsonl",
    "verbose": false
  }
}
